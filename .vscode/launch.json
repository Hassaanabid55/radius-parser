{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "C Parser",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/packet_parse",
            "args": [
                "-c",
                "${workspaceFolder}/config/radius.conf"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}